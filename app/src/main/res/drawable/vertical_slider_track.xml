<?xml version="1.0" encoding="utf-8"?>
<!--
  Authored as a HORIZONTAL progress drawable (fills left-to-right) even
  though it ends up displayed vertically - VerticalSeekBar's internal
  layout math still treats itself as a normal horizontal SeekBar and
  only rotates the canvas at draw time, so the drawable itself must
  stay in the same "horizontal" coordinate space it was always in.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2A3140" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="#34D399" />
            </shape>
        </clip>
    </item>
</layer-list>
